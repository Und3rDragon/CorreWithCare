<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="CelesteMod.props" />

    <PropertyGroup>
        <RootNamespace>$(AssemblyName)</RootNamespace>
        <LangVersion>preview</LangVersion>
        <Version>1.0.0</Version>
        <TargetFramework>net8.0</TargetFramework>

        <CelesteRootPath>E:/Steam Games/steamapps/common/Celeste</CelesteRootPath>

        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
        <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
        <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="ModFolder\Loenn\triggers\debugging\**" />
      <EmbeddedResource Remove="ModFolder\Loenn\triggers\debugging\**" />
      <None Remove="ModFolder\Loenn\triggers\debugging\**" />
    </ItemGroup>

    <ItemGroup>
      <!-- Earcut 改为纯 C# 的 Earcut.NET（mapbox/earcut 的 C# 移植，零依赖，无 FSharp.Core）。
           原 "<PackageReference Include='Earcut' ...>" 是 F# 实现，会拖带 FSharp.Core 并在 Code/ 里多一个无关 dll。 -->
      <PackageReference Include="Earcut.NET" Version="1.2.0" />
      <!-- NLua 改用 Reference + Private=False，指向 Celeste 根目录的 NLua.dll（Everest 环境自带）。
           不做 PackageReference（默认 Private=true 会复制 NLua.dll/KeraLua.dll 进 Code/），
           否则 Everest relinker 处理 NLua/KeraLua 时会抛 LockRecursionException 并拉黑该程序集。 -->
      <Reference Include="NLua">
        <HintPath>$(CelesteRootPath)/NLua.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>

